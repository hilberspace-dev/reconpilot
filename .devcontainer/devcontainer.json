{
  "name": "reconpilot",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "1.26.9" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "go build ./... && go test ./... -short",
  "postAttachCommand": "go run ./cmd/benchmark",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
